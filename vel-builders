}
/* hero */
.hero{position:relative;min-height:calc(100svh - 68px);color:#fff;display:flex;align-items:flex-end;padding:0;background:var(--violet);overflow:hidden}
.hero>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 60%;opacity:0;animation:rev 1.4s .9s forwards}
.hero::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(26,16,60,.25) 0%,rgba(26,16,60,.15) 35%,rgba(26,16,60,.88) 100%)}
.bp{position:absolute;inset:0;width:100%;height:100%;z-index:1;opacity:.9;animation:fade 1s 1.6s forwards}
.bp path{fill:none;stroke:#cfd8ff;stroke-width:1.2;vector-effect:non-scaling-stroke;stroke-dasharray:1;stroke-dashoffset:1;animation:draw 1.5s ease-out forwards}
.bp path:nth-child(2){animation-delay:.15s}.bp path:nth-child(3){animation-delay:.3s}.bp path:nth-child(4){animation-delay:.45s}.bp path:nth-child(n+5){animation-delay:.6s}
@keyframes draw{to{stroke-dashoffset:0}}
@keyframes rev{to{opacity:1}}
@keyframes fade{to{opacity:.18}}
.hero .wrap{position:relative;z-index:2;padding:0 0 clamp(4rem,9vh,6rem)}
.hero h1{color:#fff;font-size:clamp(3rem,9.5vw,7.4rem);max-width:12ch;letter-spacing:-.02em;text-shadow:0 2px 24px rgba(0,0,0,.3)}
