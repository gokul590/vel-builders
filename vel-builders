/* dark mode */
[data-theme=dark] header.nav{background:rgba(21,19,27,.94)}
[data-theme=dark] h2,[data-theme=dark] h3,[data-theme=dark] summary,[data-theme=dark] .svc a.l{color:var(--head)}
[data-theme=dark] .svcs,[data-theme=dark] .steps li{border-top-color:var(--head)}
