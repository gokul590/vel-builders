.g{overflow:hidden}
.g figcaption{position:absolute;left:0;bottom:0;padding:.4rem .9rem;background:rgba(26,16,60,.85);font-size:.9rem;font-weight:700;color:#fff}
.g.pend{display:grid;place-items:center;min-height:240px;border:1.5px dashed #8f83c9;text-align:center;padding:1rem;color:#cfc6f5;background:repeating-linear-gradient(0deg,transparent 0 31px,rgba(207,216,255,.08) 31px 32px)}
.g.pend small{display:block;font-weight:400}
.lb{position:fixed;inset:0;z-index:100;background:rgba(14,8,36,.96);display:none;align-items:center;justify-content:center;padding:3.5rem 1rem 4rem;touch-action:pan-y}
.lb.on{display:flex}
.lb img{max-height:100%;max-width:100%;object-fit:contain}
.lb .cap{position:absolute;bottom:1rem;left:0;right:0;text-align:center;color:#fff;font-weight:700}
.lb button{position:absolute;min-width:48px;min-height:48px;background:rgba(255,255,255,.12);border:0;color:#fff;font:700 1.4rem var(--sans);cursor:pointer}
.lb .x{top:.7rem;right:.7rem}.lb .p{left:.5rem;top:50%}.lb .n{right:.5rem;top:50%}
/* steps */
.steps{list-style:none;margin:2.5rem 0 0;padding:0;display:grid;gap:0;counter-reset:s}
@media(min-width:860px){.steps{grid-template-columns:repeat(4,1fr)}}
.steps li{counter-increment:s;padding:1.5rem 1.5rem 1.5rem 0;border-top:1.5px solid var(--violet);position:relative}
.steps li::before{content:counter(s);font:400 3rem/1 var(--serif);color:var(--brass);display:block;margin-bottom:.5rem}
.steps h3{font-size:1.45rem}
.steps p{font-size:1rem}
/* faq */
details{border-bottom:1px solid var(--line);padding:1rem 0}
summary{cursor:pointer;font:400 1.5rem var(--serif);color:var(--violet);min-height:44px;list-style:none;display:flex;justify-content:space-between;gap:1rem}
summary::after{content:"+";color:var(--brass)}
details[open] summary::after{content:"\2212"}
summary::-webkit-details-marker{display:none}
/* contact */
.contact{background:var(--paper);border-top:1px solid var(--line)}
.cgrid{display:grid;gap:3rem;margin-top:2rem}
@media(min-width:900px){.cgrid{grid-template-columns:1fr 1.1fr}}
.cl a{font-weight:700}
.row2{display:flex;flex-wrap:wrap;gap:.7rem;margin:1rem 0}
form{display:grid;gap:1rem}
label{font-weight:700;font-size:.95rem;display:block;margin-bottom:.25rem}
input,select,textarea{width:100%;min-height:48px;padding:.65rem .8rem;border:1.5px solid #8b8574;background:#fff;font:inherit;color:var(--ink);border-radius:0}
textarea{min-height:120px}
.err{color:#a3141c;font-size:.9rem;min-height:1.2em;margin:.2rem 0 0}
.status{padding:.9rem 1rem;border-left:4px solid var(--cobalt);background:#eaf0ff;display:none}
.status.on{display:block}.status.bad{border-color:#a3141c;background:#fdecec}
.map{margin-top:1.5rem;border:1.5px solid var(--violet);padding:1.5rem;background:repeating-linear-gradient(0deg,transparent 0 23px,rgba(31,79,216,.08) 23px 24px),repeating-linear-gradient(90deg,transparent 0 23px,rgba(31,79,216,.08) 23px 24px)}
.note{font-size:.9rem;color:#5b5666}
footer{background:#1b1140;color:#d9d0f5;padding:3.5rem 0 2rem}
