.g{margin:0;position:relative;background:#1b1140}
.g button{all:unset;display:block;width:100%;height:100%;cursor:zoom-in}
.g button:focus-visible{outline:3px solid #fff;outline-offset:-3px}
.g img{width:100%;height:100%;aspect-ratio:4/3;object-fit:cover;transition:transform .5s}
