[data-theme=dark] .btn{background:#4A38A8;border-color:#4A38A8;color:#fff}
[data-theme=dark] .btn:hover{background:#3B63E0;border-color:#3B63E0}
[data-theme=dark] .btn.ghost{background:transparent;color:var(--head);border-color:var(--head)}
[data-theme=dark] .btn.ghost:hover{background:var(--head);color:#15131B}
[data-theme=dark] .btn.light{background:#F6F1E7;color:#2A1B5C;border-color:#F6F1E7}
[data-theme=dark] .btn.light:hover{background:#fff;border-color:#fff}
[data-theme=dark] .btn.lghost{background:transparent;color:#fff;border-color:#fff}
[data-theme=dark] .btn.lghost:hover{background:#fff;color:#2A1B5C;border-color:#fff}
[data-theme=dark] input,[data-theme=dark] select,[data-theme=dark] textarea{background:#24202f;border-color:#7a7391;color:var(--ink)}
[data-theme=dark] .status{background:#1b2650}
[data-theme=dark] .status.bad{background:#3a1a22;border-color:#ff6b73}
[data-theme=dark] .err{color:#ff9aa0}
[data-theme=dark] .note{color:#aaa4b8}
[data-theme=dark] .proj{background:#1E1442}
[data-theme=dark] footer{background:#100c20}
