/* hover and tap feedback */
.btn{transition:background .2s,color .2s,transform .15s,box-shadow .2s}
.btn:hover{transform:translateY(-1px);box-shadow:0 6px 16px rgba(42,27,92,.22)}
.btn:active{transform:scale(.97);box-shadow:none}
.lang,.theme,.menu{transition:transform .15s,border-color .2s}
.lang:hover,.theme:hover,.menu:hover{border-color:var(--head)}
.lang:active,.theme:active,.menu:active{transform:scale(.94)}
nav a{background:linear-gradient(currentColor,currentColor) 0 calc(100% - 4px)/0 2px no-repeat;transition:background-size .25s,color .2s}
nav a:hover,nav a:focus-visible{background-size:100% 2px}
.svc a.l{transition:border-color .2s,color .2s}
.svc a.l:hover{border-bottom-color:var(--cobalt)}
.g img{transition:transform .5s cubic-bezier(.2,.7,.2,1),filter .3s}
.g button:hover img{filter:brightness(1.05)}
.g button:active img{transform:scale(1.015)}
/* hero */
.hero>img{opacity:0;animation:rev2 1.6s .5s both}
@keyframes rev2{from{opacity:0;transform:scale(1.05)}to{opacity:1;transform:none}}
.bp{pointer-events:none;animation:fade 1s 1.7s forwards}
.bp path{animation-delay:var(--d,0s)!important;animation-duration:1.3s}
.hero .wrap>*{animation:up .6s both}
.hero h1{animation-delay:.15s}.hero p{animation-delay:.3s}.hero .row{animation-delay:.45s}
@keyframes up{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
/* scroll reveals */
.js .rv{opacity:0;transform:translateY(16px);transition:opacity .5s ease-out,transform .5s ease-out}
.js .rv.in{opacity:1;transform:none}
/* gallery viewer */
.lb{display:flex;visibility:hidden;opacity:0;transition:opacity .22s ease,visibility 0s .22s}
.lb.on{visibility:visible;opacity:1;transition:opacity .22s ease}
.lb img{transform:scale(.96);transition:transform .28s cubic-bezier(.2,.7,.2,1)}
.lb.on img{transform:none}
.lb img.sw{animation:sw .28s ease-out}
@keyframes sw{from{opacity:0;transform:translateX(var(--dx,0))}to{opacity:1;transform:none}}
.lb button{transition:background .2s,transform .15s}
.lb button:hover{background:rgba(255,255,255,.24)}
.lb button:active{transform:scale(.94)}
/* small screens */
@media(max-width:700px){.theme span{display:none}.theme{padding:0}}
@media(max-width:520px){.nav .wrap{gap:.4rem;width:calc(100% - 1.25rem)}.logo b{font-size:1.05rem;letter-spacing:.02em}.lang{padding:0 .45rem;font-size:.8rem}.menu{padding:0}}
@media(max-width:360px){.logo b{display:none}}
/* calm version: no movement, content shown at once */
@media(prefers-reduced-motion:reduce){
 .hero>img,.hero .wrap>*{animation:none!important;opacity:1!important;transform:none!important}
 .bp{animation:none!important;opacity:.18}.bp path{animation:none!important;stroke-dashoffset:0!important}
 .js .rv{opacity:1;transform:none;transition:none}
 .lb,.lb img{transition:none!important;animation:none!important;transform:none!important}
 .btn:hover,.btn:active,.lang:active,.theme:active,.menu:active,.g button:hover img,.g button:active img{transform:none!important}
 nav a{transition:none}
 html.tt *{transition:none!important}
}

